# Cloudflare R2 Storage (S3-compatible) - Replaces @vercel/blob
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="dialycare"
# Optional public domain or r2.dev URL (leave empty to use /api/storage/ proxy)
R2_PUBLIC_URL="https://pub-your_r2_id.r2.dev"

# Session & Auth
SESSION_SECRET="your_strong_session_signing_secret"

# Firebase (Client PWA & Notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
